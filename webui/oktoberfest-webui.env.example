# Oktoberfest web UI settings
#
# Copy this file to oktoberfest-webui.env (same folder, never commit it) and adjust it:
#   cp oktoberfest-webui.env.example oktoberfest-webui.env
# Then start the web UI from this folder with:
#   docker compose --env-file oktoberfest-webui.env up --build -d
#
# Lines starting with # are comments; keep comments on their own lines (not after a value).
# Every setting has a default, so commented-out settings can stay commented out.


# ---------------------------------------------------------------------------------------------------------------------
# Docker (used by docker-compose.yml)
# ---------------------------------------------------------------------------------------------------------------------

# Where jobs, uploads, results and the job database are stored on this machine.
#   - a folder path (e.g. ./data, /mnt/storage/oktoberfest or D:\oktoberfest-data): create it first and make sure the
#     user APP_UID below can write to it
#   - a name without slashes (default okt-data): a Docker volume managed by Docker
HOST_DATA_DIR=./data

# Path of the data folder inside the containers. Job configs (config.json in each job folder) contain paths below it.
# Set it to the same absolute path as HOST_DATA_DIR if the paths in config.json should also be valid on this machine.
CONTAINER_DATA_DIR=/app/data

# User and group the containers run as, so that files in HOST_DATA_DIR belong to you.
# On Linux/macOS use the output of `id -u` and `id -g`. Docker Desktop on Windows/macOS can keep 1000.
APP_UID=1000
APP_GID=1000

# Port of the web UI: open http://localhost:8080 after starting.
API_PORT=8080
# Network interface the port is opened on: 127.0.0.1 = only this machine (default),
# 0.0.0.0 = all interfaces (other machines can reach it; use HTTPS in front of it, see README).
API_BIND=127.0.0.1


# ---------------------------------------------------------------------------------------------------------------------
# Users and access
# ---------------------------------------------------------------------------------------------------------------------

# local  = single user: every visitor sees all jobs (default, for your own machine)
# hosted = shared server: each browser gets its own session and only sees its own jobs (jobs can still be viewed by
#          anyone who knows the job id); one running job per user, threads per job capped (MAX_THREADS_PER_USER).
#          Needs the file .ip_salt in the data folder and HTTPS (see README).
APP_MODE=local

# hosted mode only: comma-separated session ids that can see and cancel all jobs (admins). A browser becomes one of
# them by setting its oktoberfest_session cookie to the value, so these act as passwords: use long random strings
# (e.g. `openssl rand -hex 24`), or leave empty.
GLOBAL_USERS=

# Comma-separated origins allowed to call the API from other web pages (hosted mode). Not needed when the frontend is
# served by this server (the default setup).
CORS_ORIGINS=


# ---------------------------------------------------------------------------------------------------------------------
# Jobs and resources
# ---------------------------------------------------------------------------------------------------------------------

# Number of jobs the worker can run at the same time.
CELERY_CONCURRENCY=1

# Maximum number of threads (CPU cores) used by all running jobs together; queued jobs wait until enough are free.
# A job uses one thread per spectra file, at most 4.
MAX_TOTAL_THREADS=4

# hosted mode only: maximum threads of a single job.
MAX_THREADS_PER_USER=4

# Maximum size of one uploaded file in bytes (5 GB).
MAX_UPLOAD_BYTES=5000000000

# Default Koina prediction server, pre-filled in the forms (users can change it per job).
PREDICTION_SERVER=koina.wilhelmlab.org:443


# ---------------------------------------------------------------------------------------------------------------------
# External tools
# ---------------------------------------------------------------------------------------------------------------------
# The Docker image includes ThermoRawFileParser, FlashLFQ, .NET 8 and Percolator and sets these paths itself.
# Only set them when running the web UI without Docker (see README, "Running without Docker").

# ThermoRawFileParser.exe (converts .raw files to mzML)
# THERMO_EXE=/opt/ThermoRawFileParser/ThermoRawFileParser.exe

# FlashLFQ command line (CMD.dll) and the dotnet executable for MS1 quantification; without FLASHLFQ_EXE the FlashLFQ
# option is disabled in the form.
# FLASHLFQ_EXE=/opt/flashlfq/CMD.dll
# DOTNET_EXE=dotnet


# ---------------------------------------------------------------------------------------------------------------------
# Running without Docker only
# ---------------------------------------------------------------------------------------------------------------------
# Docker sets these itself (from CONTAINER_DATA_DIR and its own redis). Relative paths are relative to webui/backend,
# where the backend is started, so ../data is the same webui/data folder Docker uses by default.

# DATA_DIR=../data
# DATABASE_URL=sqlite:///../data/app.db
# REDIS_URL=redis://localhost:6379/0
